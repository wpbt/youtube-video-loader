<?xml version="1.0"?>
<ruleset name="YouTube Video Loader Coding Standards">
	<description>PHPCS ruleset for the YouTube Video Loader plugin.</description>

	<!-- Scan the whole plugin, but only .php files. -->
	<arg name="extensions" value="php"/>
	<file>.</file>

	<!-- Show sniff codes and colours in the console output. -->
	<arg value="sp"/>
	<arg name="colors"/>

	<!-- Skip generated / third-party / build directories. -->
	<exclude-pattern>/vendor/*</exclude-pattern>
	<exclude-pattern>/node_modules/*</exclude-pattern>
	<exclude-pattern>/ytvl-block/build/*</exclude-pattern>
	<exclude-pattern>/ytvl-block/node_modules/*</exclude-pattern>

	<!-- WordPress Coding Standards. -->
	<rule ref="WordPress-Extra"/>
	<rule ref="WordPress-Docs"/>

	<!-- Verify that everything is correctly prefixed / text-domained. -->
	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="youtube-video-loader"/>
			</property>
		</properties>
	</rule>

	<!-- Minimum PHP version this plugin supports. -->
	<config name="testVersion" value="8.0-"/>
	<rule ref="PHPCompatibilityWP"/>
</ruleset>
