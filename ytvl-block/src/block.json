{
    "$schema": "https://schemas.wp.org/trunk/block.json",
    "apiVersion": 3,
    "name": "youtube-video-loader/ytvl-block",
    "version": "1.0.0",
    "title": "YouTube Video Loader",
    "description": "Insert YouTube videos in the page efficiently",
    "category": "media",
    "keywords": [ "yt", "youtube video loader" ],
    "supports": {
        "html": false
    },
    "attributes": {
        "embedUrl": {
            "type": "string",
            "default": ""
        },
        "useCustomPreviewImage": {
            "type": "boolean",
            "default": false
        },
        "customPreviewImage": {
            "type": "array",
            "default": []
        },
        "ytThumb": {
            "type": "string",
            "default": ""
        },
        "thumbOpacity": {
            "type": "number",
            "default": 1
        },
        "thumbFit": {
            "type": "string",
            "default": "cover"
        },
        "frameWidth": {
            "type": "integer",
            "default": 0
        }
    },
    "textdomain": "youtube-video-loader",
    "viewStyle": "file:./style-index.css",
    "editorStyle": "file:./index.css",
    "editorScript": "file:./index.js",
    "viewScript": "file:./ytvl-script.js"
}
